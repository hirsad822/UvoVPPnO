[Unit]
Description=PulseGrid — Smart Traffic & Configuration Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulsegrid
Group=pulsegrid
WorkingDirectory=/opt/pulsegrid
ExecStart=/usr/bin/python3 -m pulsegrid --host 0.0.0.0 --port 8080
Environment=PULSEGRID_CONFIG_DIR=/etc/pulsegrid
Environment=PULSEGRID_DATA_DIR=/var/lib/pulsegrid
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pulsegrid /etc/pulsegrid

[Install]
WantedBy=multi-user.target
